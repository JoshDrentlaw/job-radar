#!/usr/bin/env bash
#
# Pull-based deploy. Run by job-radar-deploy.timer.
#
# Pull rather than push (§13): nothing needs an inbound port, and no credential
# with access to this box is stored anywhere off it. A GitHub Actions job that
# SSHes in would need a private key in repository secrets, and the blast radius
# of that key is the whole droplet — including whatever else it hosts.
#
# Three things this does that `git pull && systemctl restart` does not:
#
#   1. Deploys only what CI has already gone green on. A timer that takes
#      whatever is on main will eventually take a broken commit at 3am.
#   2. Dumps the database first, because restarting applies migrations and
#      migrations are forward-only in production.
#   3. Checks the app answers afterwards, and says so loudly if it does not.
#
# It deliberately does not roll back on failure. Once a migration has been
# applied, checking out the previous commit does not undo it, and a script that
# pretends otherwise would turn one broken deploy into two problems.

set -euo pipefail

REPO=${REPO:-/opt/job-radar}
BRANCH=${BRANCH:-main}
SERVICE=${SERVICE:-job-radar}
REPO_SLUG=${REPO_SLUG:-JoshDrentlaw/job-radar}
RUN_AS=${RUN_AS:-jobradar}
ENV_FILE=${ENV_FILE:-/etc/job-radar.env}
BACKUP_DIR=${BACKUP_DIR:-/var/backups/job-radar}
DENO=${DENO:-/usr/local/bin/deno}

# Every git call runs as the user that owns the checkout. Git refuses to touch
# a repository owned by somebody else ("detected dubious ownership"), so a root
# `git rev-parse` here fails even though the fetch beside it succeeded. Adding
# safe.directory for root would silence that; dropping privilege is the better
# answer, since nothing about reading this repository needs root.
git_as() { sudo -u "$RUN_AS" git -C "$REPO" "$@"; }

log() { logger -t job-radar-deploy -- "$*"; echo "$*"; }
say() { if [ "$verbose" = true ]; then echo "$*"; fi; }
die() { log "FAILED: $*"; exit 1; }

# -v says what it decided even when the decision is "nothing to do". The timer
# runs without it, so quiet ticks stay out of the journal; a human checking by
# hand wants to see the reasoning rather than an empty prompt.
verbose=false
case "${1:-}" in
  -v | --verbose) verbose=true ;;
  "") ;;
  *) die "unknown argument: $1 (only -v or --verbose)" ;;
esac

command -v jq >/dev/null || die "jq is required (apt-get install -y jq)"

# Read what the deploy needs out of the app's env file by *parsing* it, one name
# at a time. This used to `. "$ENV_FILE"`, which had two problems:
#
#   1. Anything added to /etc/job-radar.env later could silently redefine the
#      settings above — a `SERVICE=` or `BACKUP_DIR=` line in there would
#      quietly retarget the deploy, and the failure would look like anything
#      but its cause.
#   2. systemd's EnvironmentFile takes the rest of the line as the value, but
#      `.` is shell and needs quoting. A database password containing a space —
#      which the runbook explicitly suggests — parses fine for the app and
#      truncates here, so the two disagree about the connection string.
#
# Parsing also means a value can never be executed, which sourcing could not
# promise. Last assignment wins, matching systemd.
read_env() {
  sed -n "s/^[[:space:]]*\(export[[:space:]]\{1,\}\)\{0,1\}$1=//p" "$ENV_FILE" |
    tail -n 1 | sed -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'$/\1/"
}

APP_PORT=$(read_env PORT)
APP_DATABASE_URL=$(read_env DATABASE_URL)
HEALTH="http://127.0.0.1:${APP_PORT:-8000}/healthz"

# The database to dump comes from the URL the app actually connects with, not
# from a name hardcoded here. (A password containing a literal `/` would defeat
# this; use one that does not, or set PGDATABASE in the environment.)
db_name() {
  local rest=${APP_DATABASE_URL#*://} # strip scheme
  rest=${rest#*/}                     # strip credentials, host and port
  rest=${rest%%\?*}                   # strip query parameters
  printf '%s' "${rest:-jobradar}"
}
DATABASE=${PGDATABASE:-$(db_name)}

cd "$REPO"

git_as fetch --quiet origin "$BRANCH"
current=$(git_as rev-parse HEAD)
target=$(git_as rev-parse "origin/$BRANCH")

say "watching origin/$BRANCH"
say "  deployed: ${current:0:8}"
say "  available: ${target:0:8}"

if [ "$current" = "$target" ]; then
  say "up to date — nothing to deploy"
  exit 0 # Silent without -v, because this runs every few minutes.
fi

# Only deploy a commit CI has approved. A public repository needs no token for
# this; if the checks have not finished yet, we simply try again next tick.
#
# per_page=100 because the endpoint defaults to 30: `total_count` would still be
# the true total while `.check_runs[]` held only the first page, and counting
# one against the other would hold forever. Past 100 we refuse to decide rather
# than decide on a partial view.
checks=$(curl -fsS -H 'Accept: application/vnd.github+json' \
  "https://api.github.com/repos/$REPO_SLUG/commits/$target/check-runs?per_page=100") ||
  die "could not reach the GitHub checks API"

total=$(jq -r '.total_count' <<<"$checks")
seen=$(jq -r '.check_runs | length' <<<"$checks")

if [ "$total" -eq 0 ]; then
  log "holding at ${current:0:8}: no checks reported for ${target:0:8} yet"
  exit 0
fi
if [ "$total" -gt "$seen" ]; then
  die "${target:0:8} has $total checks but the API returned $seen; refusing to judge a partial list"
fi

# A check that ran and passed, a check that was skipped, and a check that
# reported nothing conclusive are all "not a reason to hold". Counting only
# `success` meant a single conditional job whose `if:` evaluated false — which
# GitHub reports as `skipped` — would stop deploys permanently, with the reason
# buried in a journal line nobody reads.
pending=$(jq -r '[.check_runs[] | select(.status != "completed")] | length' <<<"$checks")
bad=$(jq -r '
  [ .check_runs[]
    | select(.status == "completed")
    | select(.conclusion != "success" and .conclusion != "skipped" and .conclusion != "neutral")
    | "\(.name) (\(.conclusion))"
  ] | join(", ")' <<<"$checks")

if [ "$pending" -gt 0 ]; then
  say "holding: $pending of $total checks still running"
  exit 0 # Silent without -v; the next tick will look again.
fi
if [ -n "$bad" ]; then
  log "holding at ${current:0:8}: ${target:0:8} has failing checks — $bad"
  exit 0
fi
say "  checks: $total/$total conclusive, none failing"

log "deploying ${target:0:8} ($total checks, none failing)"

# Restarting applies migrations, and they are forward-only.
mkdir -p "$BACKUP_DIR"
backup="$BACKUP_DIR/pre-deploy-$(date -u +%Y%m%dT%H%M%SZ)-${target:0:8}.dump"
sudo -u postgres pg_dump -Fc "$DATABASE" >"$backup" ||
  die "pg_dump of '$DATABASE' failed; not deploying"
find "$BACKUP_DIR" -name 'pre-deploy-*.dump' -mtime +14 -delete

# --ff-only, so a repository someone has edited by hand stops here rather than
# being silently merged.
git_as merge --ff-only "origin/$BRANCH" ||
  die "cannot fast-forward $REPO — it has local commits or changes"

# Fetch dependencies before the restart rather than during boot, and fail here
# if the lockfile does not match the code.
sudo -u "$RUN_AS" env DENO_DIR="$REPO/.deno" "$DENO" install --frozen ||
  die "dependency install failed at ${target:0:8}"

systemctl restart "$SERVICE"

for _ in $(seq 1 30); do
  sleep 1
  if curl -fsS --max-time 2 "$HEALTH" >/dev/null 2>&1; then
    log "deployed ${target:0:8}; backup at $backup"
    exit 0
  fi
done

die "${target:0:8} is deployed but $HEALTH did not answer. Backup at $backup. \
Look at: journalctl -u $SERVICE -n 50"
