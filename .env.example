# Copy to .env for local development. Never commit the real file.
# Secrets come from the environment, never the database, never the repo (§11).

# Required.
DATABASE_URL=postgres://jobradar:jobradar@127.0.0.1:5432/jobradar_dev

# development | production. Production requires an https APP_BASE_URL and
# enables Secure cookies and HSTS.
APP_ENV=development

# The app binds localhost only and is reverse-proxied by nginx (§13).
HOST=127.0.0.1
PORT=8000

# Public origin. Must be https:// when APP_ENV=production.
APP_BASE_URL=http://127.0.0.1:8000

# Advertised in the outbound User-Agent so board operators can reach a human (§15).
CONTACT_URL=https://github.com/JoshDrentlaw/job-radar

# debug | info | warn | error
LOG_LEVEL=debug

# Read only by `deno task seed-admin`, which is run once at deploy.
# There is no registration route (§11).
ADMIN_USERNAME=
ADMIN_PASSWORD=
